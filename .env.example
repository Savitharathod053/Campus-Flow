# ==============================================================================
# CAMPUS FLOW - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Target Architecture: Vercel (Frontend) + Railway (Backend) + Supabase (PostgreSQL & Storage)
# Copy this file to .env for local development. Never commit real secrets to Git.
# ==============================================================================

# ==============================================================================
# 1. RAILWAY BACKEND CORE SETTINGS
# ==============================================================================
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# 64-character random secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_64_char_random_production_secret_key_here

# Frontend URL(s) for CORS & Cross-Origin Auth Cookies (Vercel deployment domain)
# Supports single origin or comma-separated origins (e.g. https://campus-flow.vercel.app,http://localhost:3000)
FRONTEND_URL=https://your-campus-flow.vercel.app

# Cookie security (Must be True in production for HTTPS cross-site session cookies)
SESSION_COOKIE_SECURE=True

# ==============================================================================
# 2. SUPABASE POSTGRESQL DATABASE
# ==============================================================================
# Retrieve from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Mode 1: Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres?sslmode=require
#
# Mode 2: Session/Transaction Pooler (Port 6543 or 5432 - Recommended for serverless/hosted)
DATABASE_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Local Development Fallback:
# If DATABASE_URL is not set locally on Windows, it connects to local SQL Server SSMS:
# DATABASE_URL=mssql+pyodbc://@localhost/fastfest?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# ==============================================================================
# 3. SUPABASE CLOUD STORAGE (FILE UPLOADS)
# ==============================================================================
# Used for persistent cloud storage of payment receipts, event posters, organizer QRs, and certificates.
# Retrieve from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Use the 'service_role' secret key (starts with eyJ...), NOT the anon key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
# Alias supported:
# SUPABASE_KEY=your_supabase_service_role_secret_key_here

# Bucket name in Supabase Storage (Must be created and marked Public)
SUPABASE_STORAGE_BUCKET=payment-proofs
# Alias supported:
# STORAGE_BUCKET=payment-proofs

# ==============================================================================
# 4. VERCEL FRONTEND CONFIGURATION
# ==============================================================================
# Add these in Vercel Project Settings -> Environment Variables
# Points the Vercel frontend and rewrites to your Railway backend:
VITE_API_URL=https://your-campus-flow-backend.up.railway.app
BACKEND_URL=https://your-campus-flow-backend.up.railway.app
# NEXT_PUBLIC_API_URL=https://your-campus-flow-backend.up.railway.app

# ==============================================================================
# 5. EMAIL / SMTP NOTIFICATIONS (Gmail / SendGrid / Custom SMTP)
# ==============================================================================
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords (do NOT use personal Google password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_USERNAME=your_college_email@gmail.com
SMTP_PASSWORD=your_gmail_16_char_app_password
SMTP_FROM_EMAIL=your_college_email@gmail.com
SMTP_FROM_NAME="Campus Flow"

# Set to False in production so genuine emails reach participants:
MAIL_DEV_REDIRECT_ENABLED=False
MAIL_LIVE_TEST_RECIPIENT=your_college_email@gmail.com

# ==============================================================================
# 6. OCR & CERTIFICATE PROCESSING (OPTIONAL)
# ==============================================================================
# Tesseract binary path (leave blank if in system PATH)
TESSERACT_CMD=
# ROLL_NUMBER_REGEX_PATTERN=

# ==============================================================================
# 7. AI PAYMENT SCREENSHOT FRAUD DETECTION (OPTIONAL)
# ==============================================================================
HF_FRAUD_MODEL=umm-maybe/AI-image-detector