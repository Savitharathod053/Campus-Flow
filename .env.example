# FastFest Application Configuration
# ==================================
# MySQL Database Connection URL:
# Local development format: mysql+pymysql://root:password@localhost:3306/fastfest
# Cloud hosted format: mysql+pymysql://username:password@host:3306/fastfest
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fastfest

# Application Security Key (Change this in production)
SECRET_KEY=change-this-in-production

# Environment mode: 'production' for live deployment, 'development' for local coding
FLASK_ENV=production
FLASK_DEBUG=0

# Session cookie security (Set to True if serving over HTTPS / SSL)
SESSION_COOKIE_SECURE=False

# Razorpay Credentials (Get from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# Set to True for built-in sandbox mock payment verification
RAZORPAY_SANDBOX_SIMULATION=True