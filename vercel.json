{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "installCommand": "echo 'Frontend build, skipping Python dependencies'",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/static/uploads/:path*",
      "destination": "https://web-production-b67d9.up.railway.app/static/uploads/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/static/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://web-production-b67d9.up.railway.app/:path*"
    }
  ]
}