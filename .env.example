# Campus Flow - Production Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# DO NOT commit real secrets or production credentials to version control.

# ==============================================================================
# 1. CORE APPLICATION SETTINGS
# ==============================================================================
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# Strong random secret key (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_generated_64_character_random_production_secret_key_here

# ==============================================================================
# 2. MICROSOFT SQL SERVER (MSSQL / SSMS) DATABASE
# ==============================================================================
# Option A: Local SQL Server with Windows Authentication (SSMS Local)
DATABASE_URL=mssql+pyodbc://@localhost/campus_flow?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# Option B: Remote / Production SQL Server with SQL Server Authentication
# DATABASE_URL=mssql+pyodbc://db_username:db_password@sqlserver_host:1433/campus_flow?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=no

# Option C: ODBC Driver 17 fallback
# DATABASE_URL=mssql+pyodbc://@localhost/campus_flow?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# ==============================================================================
# 3. OCR & CERTIFICATE PROCESSING
# ==============================================================================
# Path to Tesseract binary (leave empty if tesseract is added to system PATH)
# Windows Example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux Example: /usr/bin/tesseract
TESSERACT_CMD=

# Custom regex pattern for extracting student roll numbers from certificates (optional override)
# ROLL_NUMBER_REGEX_PATTERN=

# ==============================================================================
# 4. EMAIL / SMTP NOTIFICATIONS (Gmail / SendGrid / Custom SMTP)
# ==============================================================================
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_college_email@gmail.com
MAIL_PASSWORD=your_gmail_16_char_app_password
MAIL_DEFAULT_SENDER=your_college_email@gmail.com

# ==============================================================================
# 5. SECURITY & COOKIES
# ==============================================================================
# Set to True when deploying behind HTTPS / SSL
SESSION_COOKIE_SECURE=True